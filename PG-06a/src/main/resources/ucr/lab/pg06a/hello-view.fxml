<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ucr.lab.pg06a.HelloController"
            stylesheets="@styles.css"
            style="-fx-background-color:#0d1117;">

    <top>
        <HBox style="-fx-background-color:#161b22; -fx-padding:8 16 8 16; -fx-spacing:12; -fx-alignment:CENTER_LEFT;">
            <Label text="PG-07" style="-fx-background-color:#f59e0b; -fx-text-fill:#0d1117; -fx-font-weight:bold; -fx-padding:2 8; -fx-font-size:13;"/>
            <Label text="Práctica para el Segundo Examen (Árboles Binarios y Grafos)"
                   style="-fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:14;"/>
            <Label text="IF-3001 · Algoritmos y Estructuras de Datos"
                   style="-fx-text-fill:#8b949e; -fx-font-size:11;"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color:#0d1117;">

            <Tab text="Grafos">
                <SplitPane dividerPositions="0.22,0.62">
                    <VBox spacing="10" style="-fx-background-color:#0d1117; -fx-padding:12;">
                        <CheckBox fx:id="graphDirCheck" text="Grafo Dirigido" onAction="#onGraphDirToggle" style="-fx-text-fill:#c9d1d9;" selected="true"/>
                        <Label text="REPRESENTACIÓN" style="-fx-text-fill:#8b949e; -fx-font-size:10;"/>
                        <ComboBox fx:id="graphReprCombo" maxWidth="Infinity" style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                        <Label text="Aristas (formato: u-v, separadas por coma):" style="-fx-text-fill:#c9d1d9; -fx-font-size:11;"/>
                        <TextArea fx:id="graphEdgesArea" prefHeight="90" promptText="Ej: 0-1,1-2,2-3,0-3"
                                  style="-fx-background-color:#161b22; -fx-text-fill:#f97316; -fx-font-size:12;"/>
                        <Label text="Ejemplo: 0-1 conecta el vértice 0 con el 1" style="-fx-text-fill:#8b949e; -fx-font-size:10;"/>
                        <Button text="▶ Generar Grafo Ejemplo" onAction="#onGraphExample"
                                maxWidth="Infinity" style="-fx-background-color:#1f6feb; -fx-text-fill:white; -fx-font-weight:bold;"/>
                        <Button text="▶ Agregar Aristas" onAction="#onGraphAddEdges"
                                maxWidth="Infinity" style="-fx-background-color:#238636; -fx-text-fill:white;"/>
                        <Button text="✕ Eliminar Aristas" onAction="#onGraphRemoveEdges"
                                maxWidth="Infinity" style="-fx-background-color:#b91c1c; -fx-text-fill:white;"/>
                        <Button text="↺ Reiniciar" onAction="#onGraphReset"
                                maxWidth="Infinity" style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                    </VBox>
                    <VBox style="-fx-background-color:#0d1117;">
                        <Label text="Visualización del Grafo" style="-fx-text-fill:#8b949e; -fx-font-size:11; -fx-padding:6 0 0 10;"/>
                        <Canvas fx:id="graphCanvas" width="650" height="480" style="-fx-background-color:#0d1117;"/>
                        <Label fx:id="graphStatsLabel" text="Grafo vacío. Genere un grafo para comenzar."
                               style="-fx-text-fill:#58a6ff; -fx-font-size:11; -fx-padding:4 10;"/>
                    </VBox>
                    <VBox spacing="8" style="-fx-background-color:#0d1117; -fx-padding:8;">
                        <Label text="Estructura y métodos del grafo" style="-fx-text-fill:#8b949e; -fx-font-size:11;"/>
                        <TextArea fx:id="graphInfoArea" prefHeight="600" editable="false" wrapText="true"
                                  style="-fx-background-color:white; -fx-text-fill:black; -fx-font-family:monospace; -fx-font-size:11; -fx-control-inner-background:white;"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <Tab text="Árboles Binarios">
                <SplitPane dividerPositions="0.2,0.65">
                    <VBox spacing="10" style="-fx-background-color:#0d1117; -fx-padding:12;">
                        <Label text="REPRESENTACIÓN" style="-fx-text-fill:#8b949e; -fx-font-size:10;"/>
                        <ComboBox fx:id="treeTypeCombo" maxWidth="Infinity"
                                  style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                        <Separator/>
                        <Button text="▶ Generar Árbol Ejemplo" onAction="#onTreeGenerate"
                                maxWidth="Infinity" style="-fx-background-color:#1f6feb; -fx-text-fill:white; -fx-font-weight:bold;"/>
                        <Button text="✕ Limpiar" onAction="#onTreeClear"
                                maxWidth="Infinity" style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                    </VBox>
                    <VBox style="-fx-background-color:#0d1117;">
                        <Label text="Visualización del Árbol" style="-fx-text-fill:#8b949e; -fx-font-size:11; -fx-padding:6 0 0 10;"/>
                        <Canvas fx:id="treeCanvas" width="700" height="480" style="-fx-background-color:#0d1117;"/>
                        <Label fx:id="treeStatsLabel" text="Árbol vacío. Genere un árbol para comenzar."
                               style="-fx-text-fill:#58a6ff; -fx-font-size:11; -fx-padding:4 10;"/>
                    </VBox>
                    <VBox spacing="8" style="-fx-background-color:#0d1117; -fx-padding:8;">
                        <Label text="Métodos del árbol binario" style="-fx-text-fill:#8b949e; -fx-font-size:11;"/>
                        <TextArea fx:id="treeInfoArea" prefHeight="600" editable="false" wrapText="true"
                                  style="-fx-background-color:white; -fx-text-fill:black; -fx-font-family:monospace; -fx-font-size:11; -fx-control-inner-background:white;"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <Tab text="bTrees Sum">
                <SplitPane dividerPositions="0.2,0.6">
                    <VBox spacing="10" style="-fx-background-color:#0d1117; -fx-padding:12;">
                        <Label text="bTreesSum(btree1, btree2)" style="-fx-text-fill:#58a6ff; -fx-font-weight:bold;"/>
                        <Button text="▶ Generar Ejemplo y Sumar" onAction="#onBTreesSum"
                                maxWidth="Infinity" style="-fx-background-color:#1f6feb; -fx-text-fill:white; -fx-font-weight:bold;"/>
                        <Button text="✕ Limpiar" onAction="#onBTreesSumClear"
                                maxWidth="Infinity" style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                    </VBox>
                    <VBox style="-fx-background-color:#0d1117;">
                        <Label text="Árbol Binario Sumado" style="-fx-text-fill:#8b949e; -fx-font-size:11; -fx-padding:6 0 0 10;"/>
                        <Canvas fx:id="btSumCanvas" width="650" height="480" style="-fx-background-color:#0d1117;"/>
                    </VBox>
                    <VBox spacing="8" style="-fx-background-color:#0d1117; -fx-padding:8;">
                        <Label text="Resultado" style="-fx-text-fill:#8b949e; -fx-font-size:11;"/>
                        <TextArea fx:id="btSumInfoArea" prefHeight="600" editable="false" wrapText="true"
                                  style="-fx-background-color:white; -fx-text-fill:black; -fx-font-family:monospace; -fx-font-size:11; -fx-control-inner-background:white;"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <Tab text="btNode Sum">
                <SplitPane dividerPositions="0.2,0.6">
                    <VBox spacing="10" style="-fx-background-color:#0d1117; -fx-padding:12;">
                        <Label text="btNodeSum(btree)" style="-fx-text-fill:#58a6ff; -fx-font-weight:bold;"/>
                        <Button text="▶ Generar Ejemplo y Calcular" onAction="#onBtNodeSum"
                                maxWidth="Infinity" style="-fx-background-color:#1f6feb; -fx-text-fill:white; -fx-font-weight:bold;"/>
                        <Button text="✕ Limpiar" onAction="#onBtNodeSumClear"
                                maxWidth="Infinity" style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                    </VBox>
                    <VBox style="-fx-background-color:#0d1117;">
                        <Label text="Árbol Binario con btNodeSum" style="-fx-text-fill:#8b949e; -fx-font-size:11; -fx-padding:6 0 0 10;"/>
                        <Canvas fx:id="btNodeSumCanvas" width="650" height="480" style="-fx-background-color:#0d1117;"/>
                    </VBox>
                    <VBox spacing="8" style="-fx-background-color:#0d1117; -fx-padding:8;">
                        <Label text="Resultado" style="-fx-text-fill:#8b949e; -fx-font-size:11;"/>
                        <TextArea fx:id="btNodeSumInfoArea" prefHeight="600" editable="false" wrapText="true"
                                  style="-fx-background-color:white; -fx-text-fill:black; -fx-font-family:monospace; -fx-font-size:11; -fx-control-inner-background:white;"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <Tab text="Tighten">
                <SplitPane dividerPositions="0.2,0.6">
                    <VBox spacing="10" style="-fx-background-color:#0d1117; -fx-padding:12;">
                        <Label text="REPRESENTACIÓN" style="-fx-text-fill:#8b949e; -fx-font-size:10;"/>
                        <ComboBox fx:id="tightenTypeCombo" maxWidth="Infinity" style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                        <Button text="▶ Generar Árbol Ejemplo" onAction="#onTightenGenerate"
                                maxWidth="Infinity" style="-fx-background-color:#1f6feb; -fx-text-fill:white; -fx-font-weight:bold;"/>
                        <Button text="▶ Aplicar tighten()" onAction="#onTightenApply"
                                maxWidth="Infinity" style="-fx-background-color:#238636; -fx-text-fill:white;"/>
                        <Button text="✕ Limpiar" onAction="#onTightenClear"
                                maxWidth="Infinity" style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                    </VBox>
                    <VBox style="-fx-background-color:#0d1117;">
                        <Label text="Visualización del Árbol" style="-fx-text-fill:#8b949e; -fx-font-size:11; -fx-padding:6 0 0 10;"/>
                        <Canvas fx:id="tightenCanvas" width="650" height="480" style="-fx-background-color:#0d1117;"/>
                    </VBox>
                    <VBox spacing="8" style="-fx-background-color:#0d1117; -fx-padding:8;">
                        <Label text="Antes / Después de tighten()" style="-fx-text-fill:#8b949e; -fx-font-size:11;"/>
                        <TextArea fx:id="tightenInfoArea" prefHeight="600" editable="false" wrapText="true"
                                  style="-fx-background-color:white; -fx-text-fill:black; -fx-font-family:monospace; -fx-font-size:11; -fx-control-inner-background:white;"/>
                    </VBox>
                </SplitPane>
            </Tab>

            <Tab text="Árbol ABM">
                <SplitPane dividerPositions="0.2,0.6">
                    <VBox spacing="10" style="-fx-background-color:#0d1117; -fx-padding:12;">
                        <Button text="▶ Generar Árboles ABM Ejemplo" onAction="#onAbmGenerate"
                                maxWidth="Infinity" style="-fx-background-color:#1f6feb; -fx-text-fill:white; -fx-font-weight:bold;"/>
                        <Button text="▶ joinABM(a, b)" onAction="#onAbmJoin"
                                maxWidth="Infinity" style="-fx-background-color:#238636; -fx-text-fill:white;"/>
                        <Button text="✕ Limpiar" onAction="#onAbmClear"
                                maxWidth="Infinity" style="-fx-background-color:#30363d; -fx-text-fill:white;"/>
                    </VBox>
                    <VBox style="-fx-background-color:#0d1117;">
                        <Label text="Resultado joinABM" style="-fx-text-fill:#8b949e; -fx-font-size:11; -fx-padding:6 0 0 10;"/>
                        <Canvas fx:id="abmCanvas" width="650" height="480" style="-fx-background-color:#0d1117;"/>
                    </VBox>
                    <VBox spacing="8" style="-fx-background-color:#0d1117; -fx-padding:8;">
                        <Label text="isABM / joinABM" style="-fx-text-fill:#8b949e; -fx-font-size:11;"/>
                        <TextArea fx:id="abmInfoArea" prefHeight="600" editable="false" wrapText="true"
                                  style="-fx-background-color:white; -fx-text-fill:black; -fx-font-family:monospace; -fx-font-size:11; -fx-control-inner-background:white;"/>
                    </VBox>
                </SplitPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>

